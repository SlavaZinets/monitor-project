# Copy this file to .env and fill in real values. Never commit .env.
# Only Docker Compose reads .env automatically; Spring Boot does not.
# Locally, Spring gets the datasource from Docker Compose support and the profile from
# -Dspring-boot.run.profiles=dev. In prod these values are passed to the app as
# real environment variables (see application-prod.properties).

SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (used by compose.yaml for the container and by the app for the datasource)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitor
DB_USERNAME=monitor
DB_PASSWORD=change-me
